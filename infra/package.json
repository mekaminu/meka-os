{
  "name": "meka-os-infra",
  "private": true,
  "version": "0.1.0",
  "bin": {
    "meka-infra": "bin/app.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "synth": "cdk synth --quiet"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "aws-cdk": "2.1143.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
