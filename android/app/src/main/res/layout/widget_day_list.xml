<?xml version="1.0" encoding="utf-8"?>
<!-- The Day list widget (the Day list, slice 6): Today, the done line and gold bar, up to four open tasks with a tick
     each, "+n more", and + Add tasks (today's Day list ready to type). Plain RemoteViews, like MEKA's other widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/day_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_day_list_title"
                android:textColor="@color/widget_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:max="100"
            android:progressBackgroundTint="@color/widget_hint"
            android:progressTint="@color/widget_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/day_row_0"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/day_tick_0"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="○"
            android:textColor="@color/widget_accent"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/day_time_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_hint"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/day_title_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/day_length_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_hint"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/day_row_1"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/day_tick_1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="○"
            android:textColor="@color/widget_accent"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/day_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_hint"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/day_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/day_length_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_hint"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/day_row_2"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/day_tick_2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="○"
            android:textColor="@color/widget_accent"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/day_time_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_hint"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/day_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/day_length_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_hint"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/day_row_3"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/day_tick_3"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="○"
            android:textColor="@color/widget_accent"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/day_time_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_hint"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/day_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/day_length_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_hint"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/day_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="8dp"
        android:text="@string/widget_day_list_empty"
        android:textColor="@color/widget_hint"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/day_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="44dp"
        android:textColor="@color/widget_hint"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/day_add"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/widget_day_list_add"
        android:textColor="@color/widget_accent"
        android:textSize="14sp" />
</LinearLayout>
