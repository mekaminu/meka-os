<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Work mode: alerts for urgent messages only (asked for when Meka turns alerts on). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Notification governor: re-register its inexact alarm after a reboot (ADR-007). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Self-updating phone app: hand a build the Mac published to Android's installer. Android asks Meka once to
         allow it ("Install unknown apps") and shows its own Install prompt every time. Personal builds only (ADR-010). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Battery care (Reliability first, slice 1): Android's own "let MEKA always run in the background?" prompt, opened
         only from Today's line on Meka's tap. Personal builds outside Play (ADR-010). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Event reminders (Remind me / Leave by): CLOCK precision only, ADR-007. Not granted by default; Meka can allow
         "Alarms & reminders" from the event detail, else reminders use a 5-minute window. Never USE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Ongoing notifications (Outside the app): Android 16's "live updates" treatment for the event countdown and a
         running fast (a normal permission, granted at install; ignored on older Android). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Alarms (slice 1): the wake alarm rings in a media-playback foreground service started from its exact alarm
         (setAlarmClock, ADR-007's wake-up row) and shows full screen over the lock screen; it vibrates. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Talk to MEKA (V1 voice slice 2): asked for the first time Meka taps the mic. Speech is recognised on the
         device only (SpeechRecognizer's on-device recogniser); nothing is recorded, kept or sent away as audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- "Where I am now" (Places item 3): approximate location only, asked for when Meka turns the switch on in
         Calendars → Weather. One fix on demand while MEKA is open (Today opening, a question about "here"); never in
         the background, never fine location. The point is rounded to about 1 km before it leaves the phone. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Spam call protection (call assistant polish 7, 8b): asked for in Work mode → Call assistant → "Recognise
         callers". Read on the phone only, never sent: contacts so a contact's calls are never stopped and a picked
         family member's every number is kept; the call log so anyone Meka called in the last 90 days is never stopped. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Talk to MEKA: see the speech recogniser and the text-to-speech engine on Android 11+ (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".MekaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meka"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Talk without tapping the mic (slice 1): with MEKA chosen as the digital assistant app, holding the side key
             (or the assist gesture) sends ACTION_ASSIST here; holding a headset's button sends VOICE_COMMAND. It shows
             nothing and opens MainActivity on Ask already listening (on-device recogniser only, as for the mic). -->
        <activity
            android:name=".ask.TalkStartActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Capture from anywhere (build plan M1): share sheet, "Capture in MEKA" on selected text, widget and tile.
             The sheet shows what arrived; nothing is saved until Meka taps Add. Own task so it never drags the app up. -->
        <activity
            android:name=".capture.CaptureActivity"
            android:exported="true"
            android:label="@string/capture_in_meka"
            android:taskAffinity="os.meka.android.capture"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Meka.Capture"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".capture.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_capture"
            android:label="@string/capture_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>

        <receiver
            android:name=".capture.CaptureWidgetProvider"
            android:exported="true"
            android:label="@string/capture_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/capture_widget_info" />
        </receiver>

        <!-- Home-screen widgets (Outside the app, slice 2): Next up, Needs you and Fast. Plain RemoteViews; the
             launcher ticks their clocks; redrawn when what they say changes and on their own windowed alarm (ADR-007). -->
        <receiver
            android:name=".widgets.NextUpWidgetProvider"
            android:exported="true"
            android:label="@string/widget_next_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/next_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.NeedsYouWidgetProvider"
            android:exported="true"
            android:label="@string/widget_needs_you_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/needs_you_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.FastWidgetProvider"
            android:exported="true"
            android:label="@string/widget_fast_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/fast_widget_info" />
        </receiver>
        <!-- Talk widget (Talk without tapping the mic, slice 2): a tap opens Ask already listening. No data, no refresh. -->
        <receiver
            android:name=".ask.TalkWidgetProvider"
            android:exported="true"
            android:label="@string/widget_talk_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/talk_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.HomeWidgetAlarmReceiver"
            android:exported="false" />

        <!-- News widget (news ticker slice 3a): picture headlines the launcher flips through every 5 s, 4x1 and 4x2.
             The cards come from NewsWidgetService (bound only by the system's widget host). -->
        <receiver
            android:name=".widgets.NewsStripWidgetProvider"
            android:exported="true"
            android:label="@string/widget_news_strip_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/news_strip_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.NewsCardWidgetProvider"
            android:exported="true"
            android:label="@string/widget_news_card_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/news_card_widget_info" />
        </receiver>
        <service
            android:name=".widgets.NewsWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <receiver
            android:name=".widgets.NewsWidgetPageReceiver"
            android:exported="false" />
        <receiver
            android:name=".widgets.NewsWidgetAlarmReceiver"
            android:exported="false" />

        <!-- Work mode (build plan M1): official notification access only; Meka grants it in Settings.
             Reads WhatsApp, SMS and missed calls during work hours; never replies or marks anything read. -->
        <service
            android:name=".work.WorkCaptureService"
            android:exported="true"
            android:label="@string/work_capture_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
        </service>

        <!-- Call assistant (build plan M1, Needs Meka #9): Android's call screening role, granted by Meka in the Work
             screen. During work, with the assistant's switch on, calls from anyone but family, the always-notify
             list and repeat callers are declined (busy), so the carrier's "forward when busy" sends them on.
             Off work or switched off, every call rings. It never answers a call and never reads call audio. -->
        <service
            android:name=".work.MekaCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Work mode: an inexact alarm near the end of work (setWindow, ADR-007) for the "summary ready" nudge. -->
        <receiver
            android:name=".work.WorkEndReceiver"
            android:exported="false" />

        <!-- Notification governor (build plan M1): its own inexact alarm (setWindow, ADR-007) for the next digest,
             the end of quiet hours or the next heads-up; and a restart hook that re-arms alarms after a reboot or
             an update. -->
        <receiver
            android:name=".notify.GovernorAlarmReceiver"
            android:exported="false" />
        <!-- Ongoing notifications (Outside the app): their windowed alarm (ADR-007) and the swipe-away record. -->
        <receiver
            android:name=".notify.OngoingAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".notify.OngoingDismissReceiver"
            android:exported="false" />
        <!-- Gym slice 2b: Went / Didn't go on "Did you go?", and the Undo on the note that replaces it. -->
        <receiver
            android:name=".notify.NoticeActionReceiver"
            android:exported="false" />
        <!-- Fasting v2: End fast and its Undo from the ongoing notification. -->
        <receiver
            android:name=".notify.OngoingFastReceiver"
            android:exported="false" />
        <!-- Self-updating phone app: the install session's status (Android's Install prompt, then success or failure). -->
        <receiver
            android:name=".update.UpdateStatusReceiver"
            android:exported="false" />
        <!-- Alarms (slice 1): the wake alarm. The receiver is its setAlarmClock target; the service rings it (sound on the
             alarm stream, rising, and vibration) until it's snoozed, dismissed here or on the Mac, or 10 minutes pass;
             the activity is the full-screen ringing screen over the lock screen. -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />
        <service
            android:name=".alarm.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity
            android:name=".alarm.AlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="os.meka.android.alarm"
            android:theme="@style/Theme.Meka" />
        <!-- Push via Firebase (build plan M1): data-only "sync now" wake-ups from MEKA's own server; nothing shown.
             Firebase's automatic analytics collection is off (MEKA doesn't include Analytics anyway). -->
        <service
            android:name=".push.MekaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />

        <receiver
            android:name=".notify.RestartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
