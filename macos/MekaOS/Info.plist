<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Navilife</string>
    <key>CFBundleDisplayName</key>
    <string>Navilife</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>MekaSyncURL</key>
    <string>$(MEKA_SYNC_URL)</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Navilife listens while you talk to it, and records the voice notes you start. Your voice is turned into words on this Mac; a voice note's recording is kept on this Mac only, encrypted, and never sent away.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Navilife turns what you say into words on this Mac only, for Talk and voice notes. Nothing is sent to Apple.</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>os.meka.mac.publish</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>mekaos</string>
            </array>
        </dict>
    </array>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Add to Navilife</string>
            </dict>
            <key>NSMessage</key>
            <string>captureText</string>
            <key>NSPortName</key>
            <string>$(PRODUCT_NAME)</string>
            <key>NSRequiredContext</key>
            <dict/>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Handle this with Navilife</string>
            </dict>
            <key>NSMessage</key>
            <string>handleText</string>
            <key>NSPortName</key>
            <string>$(PRODUCT_NAME)</string>
            <key>NSRequiredContext</key>
            <dict/>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Add to Navilife Reading</string>
            </dict>
            <key>NSMessage</key>
            <string>readingText</string>
            <key>NSPortName</key>
            <string>$(PRODUCT_NAME)</string>
            <key>NSRequiredContext</key>
            <dict/>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Handle this picture with Navilife</string>
            </dict>
            <key>NSMessage</key>
            <string>handlePicture</string>
            <key>NSPortName</key>
            <string>$(PRODUCT_NAME)</string>
            <key>NSRequiredContext</key>
            <dict/>
            <key>NSSendTypes</key>
            <array>
                <string>public.image</string>
                <string>public.png</string>
                <string>public.tiff</string>
            </array>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.image</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
