<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>MekaSyncURL</key>
    <string>$(MEKA_SYNC_URL)</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>MEKA listens while you talk to it. Your voice is turned into words on this Mac and never recorded or sent away.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>MEKA turns what you say into words on this Mac only, so you can talk to it. Nothing is sent to Apple or kept.</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>os.meka.mac.publish</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>mekaos</string>
            </array>
        </dict>
    </array>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Add to MEKA</string>
            </dict>
            <key>NSMessage</key>
            <string>captureText</string>
            <key>NSPortName</key>
            <string>$(PRODUCT_NAME)</string>
            <key>NSRequiredContext</key>
            <dict/>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
